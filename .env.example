# Copy to .env and fill in. server.js reads these from the process environment;
# on Node 20.6+ you can load the file with:  node --env-file=.env server.js

# Required. Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Uncomment to override the defaults shown.
# GEMINI_MODEL=gemini-flash-latest
# ADMIN_TOKEN=letmein
# PORT=3000
